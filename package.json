{
  "name": "diffhex",
  "productName": "DiffHex",
  "version": "2.40.0",
  "description": "Edytor i porownywarka plikow binarnych ECU",
  "author": "dar0",
  "license": "UNLICENSED",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/HexDiff-byDar0/DiffHex.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^31.7.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.dar0.diffhex",
    "productName": "DiffHex",
    "files": [
      "main.js",
      "preload.js",
      "app/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "DiffHex-Setup-${version}.${ext}",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DiffHex",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "fileAssociations": [
      { "ext": "bin", "name": "ECU binary", "description": "Plik binarny ECU", "role": "Editor", "icon": "build/icon.ico" },
      { "ext": "ori", "name": "DiffHex original", "description": "Plik oryginalny (DiffHex)", "role": "Editor", "icon": "build/icon.ico" },
      { "ext": "mod", "name": "DiffHex modified", "description": "Plik zmodyfikowany (DiffHex)", "role": "Editor", "icon": "build/icon.ico" },
      { "ext": "mpc", "name": "ECU map", "description": "Plik ECU (DiffHex)", "role": "Editor", "icon": "build/icon.ico" },
      { "ext": "dtf", "name": "ECU data", "description": "Plik ECU (DiffHex)", "role": "Editor", "icon": "build/icon.ico" },
      { "ext": "frf", "name": "ECU frf", "description": "Plik ECU (DiffHex)", "role": "Editor", "icon": "build/icon.ico" },
      { "ext": "dec", "name": "ECU decoded", "description": "Plik ECU (DiffHex)", "role": "Editor", "icon": "build/icon.ico" }
    ],
    "directories": {
      "buildResources": "build"
    }
  }
}