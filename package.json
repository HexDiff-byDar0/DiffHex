{
  "name": "diffhex",
  "productName": "DiffHex",
  "version": "2.36.0",
  "description": "Edytor i porownywarka plikow binarnych ECU",
  "author": "dar0",
  "license": "UNLICENSED",
  "main": "main.js",
  "repository": { "type": "git", "url": "https://github.com/HexDiff-byDar0/DiffHex.git" },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^31.7.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.dar0.diffhex",
    "productName": "DiffHex",
    "files": ["main.js", "preload.js", "app/**/*"],
    "win": {
      "target": ["nsis"],
      "artifactName": "DiffHex-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DiffHex"
    },
    "fileAssociations": [
      { "ext": "bin", "name": "ECU binary", "description": "Plik binarny ECU", "role": "Editor" }
    ]
  }
}
